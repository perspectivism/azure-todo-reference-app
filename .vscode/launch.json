{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Functions (Todo.Api)",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:azureFunctions.pickProcess}",
      "preLaunchTask": "func: host start"
    },
    {
      "name": "Debug Blazor (Todo.Web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: web",
      "program": "${workspaceFolder}/src/Todo.Web/bin/Debug/net10.0/Todo.Web.dll",
      "cwd": "${workspaceFolder}/src/Todo.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5230"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\bNow listening on:\s+(https?://\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug local stack (API + Web)",
      "configurations": ["Debug Functions (Todo.Api)", "Debug Blazor (Todo.Web)"],
      "stopAll": true
    }
  ]
}
