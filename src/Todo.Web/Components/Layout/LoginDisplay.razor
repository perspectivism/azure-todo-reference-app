@using Todo.Web.Auth

<AuthorizeView>
    <Authorized>
        <span class="me-3 profile">
            <span class="profile-name">@(context.User.FindFirst(WebClaims.Name)?.Value ?? "Signed in")</span>
            @if (context.User.FindFirst(WebClaims.SignInName)?.Value is { } signInName)
            {
                <small class="text-muted ms-1 profile-sign-in-name">(@signInName)</small>
            }
        </span>
        <form method="post" action="authentication/sign-out" class="d-inline">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-sm btn-outline-secondary">Sign out</button>
        </form>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-sm btn-primary" href="authentication/sign-in">Sign in</a>
    </NotAuthorized>
</AuthorizeView>
