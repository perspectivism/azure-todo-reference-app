<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Optional local Entra sign-in keeps its client secret in dotnet user-secrets, never in the repository. -->
    <UserSecretsId>todo-web-local-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Todo.Contracts\Todo.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Todo.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development-only settings (Auth:Mode=Dev) are never published. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.15.0" />
  </ItemGroup>

</Project>
